# =====================================================================
# VR CAP - environment
#
# TWO KINDS OF VARIABLE, and mixing them up is the usual deployment trap:
#
#   RUNTIME     read by the server when the container starts. Set these as
#               normal environment variables in Coolify.
#   BUILD TIME  inlined into the client bundle by Vite during the image
#               build. Setting these as runtime variables does NOTHING -
#               the bundle is already compiled. In Coolify they go under
#               Build > Build Arguments (or leave them at their defaults).
# =====================================================================

# ---------------- RUNTIME (server) ----------------

PORT=8080
NODE_ENV=production
HOST=0.0.0.0

# PostgreSQL. On Coolify use the INTERNAL hostname of the managed database
# (the "Postgres URL (internal)" shown on the database page), not the public
# one - app-to-database traffic stays inside the Docker network.
#   postgres://<user>:<password>@<internal-host>:5432/<db>
DATABASE_URL=postgres://vrcap:CHANGE_ME@postgres:5432/vrcap

# Coolify's managed Postgres does not use TLS on the internal network.
PGSSLMODE=disable

# Run pending migrations on boot. Safe to leave on: migrations are idempotent
# and a failure is logged without taking the server down.
AUTO_MIGRATE=true

# Comma separated list of allowed origins. "*" is fine while the client is
# served from the same origin as the API; tighten it if you split them.
CORS_ORIGIN=*

# Optional shared secret for /api/admin endpoints. Leave empty to disable them.
ADMIN_TOKEN=

# Store runs from participants who did not enter an ID (unlinked, for norms).
STORE_ANONYMOUS_RUNS=true

# Where the built client lives, relative to packages/server/dist.
# The Dockerfile sets this already; only change it for an unusual layout.
CLIENT_DIR=../client/dist

# ---------------- BUILD TIME (client, Vite) ----------------

# Leave both empty for the recommended single-container setup: the server
# serves the client, so the API and the WebSocket are same-origin and the
# client derives wss:// from the page's own protocol.
VITE_API_BASE=
VITE_WS_BASE=

# External Shepard-Metzler deployment (SPACE / module 02).
VITE_SHEPARD_URL=https://mindview-vr.vercel.app/
